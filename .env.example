# ===================================
# VedaHaat Environment Configuration
# ===================================

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://vedahaat.in

# Razorpay Payment Gateway Keys (From Razorpay Dashboard: Settings > API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Brand Admin Email for Receiving Order Notifications
ADMIN_EMAIL=info@vedahaat.in

# SMTP Email Configuration (ServerByte cPanel Webmail / SMTP)
SMTP_HOST=smtp.vedahaat.in
SMTP_PORT=465
SMTP_USER=info@vedahaat.in
SMTP_PASS=your_email_account_password
SMTP_FROM="VedaHaat Orders <info@vedahaat.in>"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin Dashboard Password (for /admin access)
ADMIN_PASSWORD=your_secure_admin_password
